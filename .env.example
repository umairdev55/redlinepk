# OneSignal Web Push App ID.
# Create a free Web app at https://onesignal.com, then copy the App ID from
# Dashboard → Settings → Keys & IDs. Set this in Vercel → Project Settings →
# Environment Variables (Production), then redeploy. Leave empty to disable
# push notifications — the site works fine without it.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Public site URL used for canonical links, Open Graph, sitemap and RSS.
# Leave empty to use https://redlinepk.com. Until that domain is registered
# and connected in Vercel, set this to the live URL
# (https://redlinepk.vercel.app) so search engines see the real address.
# Remove it again after the domain is connected, then redeploy.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Create a free property at https://analytics.google.com, then copy the ID
# from Admin → Data Streams → your web stream. Set it in Vercel, then
# redeploy. Leave empty to disable analytics — the site works fine without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (HTML tag method).
# At https://search.google.com/search-console add the site, choose the
# "HTML tag" method and paste only the content="..." value here. Set it in
# Vercel, redeploy, then click Verify in Search Console. Leave empty to skip.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
